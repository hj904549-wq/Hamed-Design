# Sanity CMS — variable names documentation
# Copy this file to `.env` and fill in values.
# The Sanity Studio authenticates via `npx sanity login` (no token needed for local dev).
# A token is only required for CI/CD writes (e.g. pushing docs), not for the frontend reads.

# Public project identifiers (already hardcoded in scripts/sanity.js)
SANITY_API_TOKEN=